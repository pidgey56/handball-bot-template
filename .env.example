# Mode d'exécution : 'setup', 'poll', 'send_text', 'sync_votes'
MODE=setup

# Votre numéro de téléphone au format international (sans +) pour la liaison WhatsApp
# Exemple : 33612345678
PHONE_NUMBER=33600000000

# ID du groupe WhatsApp cible (obtenu en mode setup, format : xxxxx@g.us)
GROUP_ID=120363xxxxxxxxx@g.us

# Paramètres optionnels pour le mode poll
POLL_TITLE=Disponibilités semaine du 12/10
POLL_OPTIONS=["Entraînement Lundi 20h30","Dispo match Samedi 20h"]

# Paramètre pour le mode send_text
TEXT_MESSAGE=Bonjour à tous, voici les convocations du week-end !

# Durée d'écoute des votes en secondes (par défaut : 120s)
LISTEN_SECONDS=120
